# === LLM provider switch ===
LLM_PROVIDER=auto
GEMINI_MODEL=gemini-2.5-flash

# === NVIDIA model options (comma-separated; UI picks one) ===
NVIDIA_MODELS=deepseek-ai/deepseek-v4.1-flash,z-ai/glm-5.3-flash,nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash

# === API keys (Secret Manager on Cloud Run, .env locally) ===
GOOGLE_API_KEY=
NVIDIA_API_KEY=

# === Retrieval params ===
TOP_K=3
TEMPERATURE=0.2
RELEVANCE_THRESHOLD=0.35
MAX_TOKENS=512

# === GCP ===
GCS_BUCKET=